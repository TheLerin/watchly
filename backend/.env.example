NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Same Supabase project/public key as the frontend; JWTs are verified by Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only: legacy service_role JWT API key for the restricted invite RPC.
# Never expose this as VITE_*, send it to the browser, or use it for user reads.
SUPABASE_SERVICE_ROLE_KEY=

# Required in production for cross-network voice and Screen Share Beta.
TURN_URLS=turn:turn.example:3478?transport=udp,turns:turn.example:443?transport=tcp
TURN_SHARED_SECRET=replace-with-coturn-rest-secret
TURN_USERNAME_PREFIX=watchly
TURN_TTL_SECONDS=3600
