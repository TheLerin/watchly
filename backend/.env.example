NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# Same Supabase project/public key as the frontend; JWTs are verified by Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only: legacy service_role JWT API key for the restricted invite RPC.
# Never expose this as VITE_*, send it to the browser, or use it for user reads.
SUPABASE_SERVICE_ROLE_KEY=

# LiveKit Cloud voice: backend only. Never use VITE_* names for these values.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Independent media-cookie signing secret; required by the room-authorized Drive proxy.
MEDIA_SESSION_SECRET=
# Shared only with the optional Cloudflare Drive bridge. Use a separate random value.
GDRIVE_LEGACY_SECRET=
# Default 0 trusts only the TCP peer. Configure 1 only behind one verified proxy hop.
TRUST_PROXY_HOPS=0

# Retained for legacy WebRTC voice rollback and Screen Share Beta.
TURN_URLS=turn:turn.example:3478?transport=udp,turns:turn.example:443?transport=tcp
TURN_SHARED_SECRET=replace-with-coturn-rest-secret
TURN_USERNAME_PREFIX=watchly
TURN_TTL_SECONDS=3600
