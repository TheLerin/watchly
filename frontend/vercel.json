{
    "headers": [
        { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
        { "source": "/auth/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
        { "source": "/auth/callback", "headers": [{ "key": "Cache-Control", "value": "no-store" }, { "key": "Referrer-Policy", "value": "no-referrer" }] },
        { "source": "/my-watchly", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
        { "source": "/profile", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
        { "source": "/setup-profile", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
