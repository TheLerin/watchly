{
    "functions": {
        "api/room-preview.js": {
            "includeFiles": "dist/index.html"
        }
    },
    "rewrites": [
        {
            "source": "/room/:roomCode",
            "destination": "/api/room-preview?roomCode=:roomCode"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
