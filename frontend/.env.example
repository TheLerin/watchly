VITE_BACKEND_URL=http://localhost:5000
# Legacy development above uses Socket.IO. Cloudflare builds force same-origin native transport.
# For Vite + Wrangler development, clear VITE_BACKEND_URL and set this to native.
VITE_REALTIME_TRANSPORT=socketio

# Public browser configuration. Leave blank to keep accounts disabled.
# Never put a service-role key or Google client secret in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development-only relay verification. Never set this in the production UI.
VITE_FORCE_RELAY=false

# Optional rollback while LiveKit migration is verified. Default is livekit.
# This is a public provider selector, not a credential.
VITE_VOICE_PROVIDER=livekit
VITE_MEDIA_PROVIDER=livekit
# Optional local estimated byte budget; zero disables it. This is not a provider billing cap.
VITE_MEDIA_SESSION_LIMIT_MB=0

# Public canonical URL, privacy contact and optional ownership tags (not secrets).
VITE_SITE_ORIGIN=https://wchly.pages.dev
VITE_PRIVACY_CONTACT_EMAIL=assist.watchly@gmail.com
VITE_SITE_OPERATOR=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=D076BA3A466F949A85D20E308F1132CA
