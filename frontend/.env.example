VITE_BACKEND_URL=http://localhost:5000

# Public browser configuration. Leave blank to keep accounts disabled.
# Never put a service-role key or Google client secret in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Development-only relay verification. Never set this in the production UI.
VITE_FORCE_RELAY=false
