{
  "name": "watchly-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-cloudflare.mjs && node scripts/prepare-assets.mjs",
    "dev": "wrangler dev",
    "test": "node --test workers/test/*.test.mjs",
    "test:integration": "node workers/test/integration.mjs",
    "test:browser": "node workers/test/browser.cjs",
    "test:browser:harness": "node workers/test/browser-harness.mjs",
    "test:load": "node workers/test/load.mjs",
    "check:deploy": "wrangler deploy --dry-run --outdir .worker-build",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "verify": "node scripts/verify.mjs",
    "test:benchmark": "node workers/test/benchmark.mjs",
    "test:runtime": "node workers/test/workerd-direct.mjs",
    "test:soak": "node workers/test/soak.mjs",
    "test:presence": "node workers/test/presence-benchmark.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "4.168.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
