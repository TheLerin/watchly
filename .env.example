# Copy the public values into frontend/.env.local for local builds.
VITE_REALTIME_TRANSPORT=native
VITE_BACKEND_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VOICE_PROVIDER=livekit
VITE_MEDIA_PROVIDER=livekit
VITE_MEDIA_SESSION_LIMIT_MB=0
VITE_FORCE_RELAY=false
# Optional actual deployment origin for absolute social metadata/canonical URLs.
VITE_SITE_ORIGIN=
